# 环境变量示例：复制为 backend/.env 后按需修改。
# 复制命令（PowerShell）：Copy-Item backend\.env.example backend\.env

# ---- 数据库 ----
# 本项目默认使用隔离的本地 MySQL 实例（端口 3307），详见 README「数据库」
DATABASE_URL=mysql+pymysql://hospital_app:hospital_pwd_2026@127.0.0.1:3307/hospital?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://hospital_app:hospital_pwd_2026@127.0.0.1:3307/hospital_test?charset=utf8mb4

# 若使用 Docker Compose 中的 mysql 服务，则改为：
# DATABASE_URL=mysql+pymysql://hospital_app:hospital_pwd_2026@mysql:3306/hospital?charset=utf8mb4

# ---- 安全 ----
SECRET_KEY=dev-secret-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- 跨域（前端 Vite 开发服务器）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
