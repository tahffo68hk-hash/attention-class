# 环境变量示例：复制为「本目录下的 .env」（供 docker compose 变量插值使用）
# 复制命令（PowerShell）：Copy-Item .env.example .env
#
# ⚠️ 真正的 .env 被 .gitignore 排除，**绝不要**把填了真实取值的内容提交或推送。
#    本示例文件只允许出现占位符。

# ---- 数据库 ----
# 本项目默认使用隔离的本地 MySQL 实例（端口 3307），详见 README「数据库」
DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital_test?charset=utf8mb4

# 若使用 Docker Compose 中的 mysql 服务，则改为（主机名用服务名 mysql）：
# DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@mysql:3306/hospital?charset=utf8mb4

# ---- 安全 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<YOUR_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- 跨域（前端 Vite 开发服务器）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- docker compose 专用（仅当使用 docker-compose.yml 时填写）----
# compose 会对 docker-compose.yml 里出现的 ${...} 做变量插值，取值来自本文件。
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_PASSWORD=<YOUR_APP_DB_PASSWORD>
