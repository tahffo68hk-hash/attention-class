# ============================================================================
# 仓库根目录 .env 示例 —— 只给 docker compose 做变量插值用
#   PowerShell： Copy-Item .env.example .env
#   bash：       cp .env.example .env
#
# 真正的 .env 被 .gitignore 排除；本示例只放占位符，可安全提交。
# 本机（不用 Docker）跑后端时，请改用 backend/.env（见 backend/.env.example）。
#
# 缺项时 docker compose 会直接报错退出，而不是回落到弱默认值。
# ============================================================================

# ---- 数据库（compose 的 mysql 服务）----
# root 口令：仅用于容器内 mysqladmin 健康检查与运维
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
# 应用账号 hospital_app 的口令（后端连接串由 compose 拼接，无需手写 URL）
MYSQL_PASSWORD=<YOUR_APP_DB_PASSWORD>
# 演示库名，默认 hospital
MYSQL_DATABASE=hospital

# ---- 安全 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<YOUR_SECRET_KEY>

# ---- 演示数据 ----
# true：后端启动时若发现空库，自动写入演示数据；卷已有数据则跳过
AUTO_SEED=true

# ---- 说明：以下变量只在「不用 Docker、本机直跑」时使用 ----
# 真实取值放 backend/.env（该文件不入库），此处仅列出便于对照：
#   DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital?charset=utf8mb4
#   TEST_DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital_test?charset=utf8mb4
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
