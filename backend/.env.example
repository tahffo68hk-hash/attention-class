# ============================================================================
# 后端环境变量示例（复制为 backend/.env 后按需修改）
#   PowerShell： Copy-Item backend\.env.example backend\.env
#   bash：       cp backend/.env.example backend/.env
#
# 本文件只放占位符，**不含任何真实凭据**，可以安全提交。
# backend/.env 已被 .gitignore 排除，真实取值只放那里或环境变量。
#
# 注意（有意的 fail-fast）：SECRET_KEY 或数据库口令仍是占位符时，
# 应用会拒绝启动并打印原因，避免"默认弱口令"悄悄生效。
# ============================================================================

# ------------------------------- 应用 -------------------------------
APP_NAME=医院床位智能分配与住院入院预办理系统
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

# ------------------------------- 数据库 -------------------------------
# 本地隔离实例（端口 3307）；用 Docker Compose 时主机名改为 mysql:3306
DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital?charset=utf8mb4
# 测试库：库名必须以 _test 结尾，否则 tests/conftest.py 拒绝删表（fail-closed）
TEST_DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital_test?charset=utf8mb4
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30

# ------------------------------- 安全 -------------------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<YOUR_SECRET_KEY>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 默认脱敏：患者姓名 / 手机号打码；查看明文需管理员权限并写审计
MASK_BY_DEFAULT=true

# ------------------------------- 跨域 -------------------------------
# 逗号分隔；前端 Vite 开发服务器 5173，静态预览 4173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --------------------- P2 辅助解释（可选，默认关闭）---------------------
# 默认只用确定性规则解释评分。未获明确授权不要开启真实模型。
ASSISTANT_EXTERNAL_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# ------------- P4 DeepSeek（可选，默认关闭；开启会产生真实费用）-------------
# 双重开关：DEEPSEEK_EXTERNAL_ENABLED=true 且请求里显式确认才会真正外发。
DEEPSEEK_EXTERNAL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15
DEEPSEEK_MAX_OUTPUT_TOKENS=500
# 费用估算（可选，人民币 / 百万 token）；留空表示不估价，不是官方账单
DEEPSEEK_INPUT_MISS_CNY_PER_M=
DEEPSEEK_INPUT_HIT_CNY_PER_M=
DEEPSEEK_OUTPUT_CNY_PER_M=
