# 数据库（本项目使用隔离的本地 MySQL 实例，端口 3307）
DATABASE_URL=mysql+pymysql://hospital_app:hospital_pwd_2026@127.0.0.1:3307/hospital?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://hospital_app:hospital_pwd_2026@127.0.0.1:3307/hospital_test?charset=utf8mb4

# 安全
SECRET_KEY=dev-secret-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 跨域（前端 Vite 开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# P2 辅助解释：默认只用确定性规则。未获明确授权不要开启真实模型。
ASSISTANT_EXTERNAL_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
