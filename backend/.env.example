# 环境变量示例：复制为 backend/.env 后按需修改。
# 复制命令（PowerShell）：Copy-Item backend\.env.example backend\.env
#
# ⚠️ backend/.env 被 .gitignore 排除。**任何真实凭据只允许出现在 backend/.env**，
#    示例文件里只放占位符 —— 占位符会导致应用拒绝启动（见 app/core/config.py）。

# 数据库（本项目使用隔离的本地 MySQL 实例，端口 3307）
DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://hospital_app:<YOUR_APP_DB_PASSWORD>@127.0.0.1:3307/hospital_test?charset=utf8mb4

# 安全
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<YOUR_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 跨域（前端 Vite 开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# P2 辅助解释：默认只用确定性规则。未获明确授权不要开启真实模型。
ASSISTANT_EXTERNAL_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# P4 DeepSeek（当前官方模型：deepseek-flash 或 deepseek-v4-pro）
# 仅在用户明确允许付费 Pilot 时，才设置 true 并执行真实调用。
DEEPSEEK_EXTERNAL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=15
DEEPSEEK_MAX_OUTPUT_TOKENS=500
# 费用估算可选：填入官方当前对应时段的每百万 token 人民币单价；留空则不估价
DEEPSEEK_INPUT_MISS_CNY_PER_M=
DEEPSEEK_INPUT_HIT_CNY_PER_M=
DEEPSEEK_OUTPUT_CNY_PER_M=
